# FastAPI
ENVIRONMENT=production
PUBLIC_BASE_URL=https://example.com
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database / cache
DATABASE_URL=postgresql://transcribe_user:transcribe_pass@postgres:5432/transcribe_db
REDIS_URL=redis://redis:6379

# Storage
STORAGE_ROOT=/storage
WHISPER_CACHE_DIR=/models
FILE_RETENTION_DAYS=30

# Free tier limits
MONTHLY_CAP_MIN=100
MAX_FILE_SIZE_MB=25
MAX_DURATION_MIN=20
CONCURRENT_JOB_LIMIT=1
RATE_LIMIT_BURST=10
RATE_LIMIT_RATE=10

# Audio models
WHISPER_MODEL=medium
WHISPER_BEAM_SIZE=5
ENABLE_DIARIZATION=true
HUGGINGFACE_TOKEN=

# Security
COOKIE_SIGNING_KEY=change-me-super-secret
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Observability
PROMETHEUS_ENABLE=true
TRACING_ENABLED=false

# Misc
TEMP_DIR=/tmp/transcribe
